# PingWAF systemd service
# ─────────────────────────────────────────────────────────────────────────────
# Install to: /etc/systemd/system/pingwaf.service
# Enable:     sudo systemctl enable --now pingwaf
# Status:     sudo systemctl status pingwaf
# Logs:       sudo journalctl -u pingwaf -f
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=PingWAF - High Performance Web Application Firewall
Documentation=https://github.com/shuaiZend/PingWAF
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pingwaf
Group=pingwaf
# The example pingwaf.toml uses a relative cache_dir ("./data/cache"). systemd
# starts units in "/" and ProtectSystem=strict makes /data read-only, so the
# agent's cache/ACME state would fail to persist; keep the working directory on
# the writable data volume.
WorkingDirectory=/var/lib/pingwaf
ExecStart=/usr/local/bin/pingwaf all-in-one
# There is no reload signal: edit the configuration file (or the environment
# below) and restart the unit.
Restart=always
RestartSec=5
LimitNOFILE=65536
Environment=RUST_LOG=info,sqlx=warn
# Instance secrets (PINGWAF_SECRET_KEY) live in a 0600 file written by
# install.sh; the leading dash keeps the unit working when it does not exist.
EnvironmentFile=-/etc/pingwaf/pingwaf.env
# A manual unit has no memory probe. On hosts below 4 GiB, pin mimalloc's first
# arena before it starts (install.sh computes this automatically):
#Environment=MIMALLOC_ARENA_RESERVE=268435456
#Environment=MIMALLOC_ARENA_EAGER_COMMIT=0
# Uncomment to read settings from a file — the environment above wins over it,
# and a command-line flag wins over both. The path must exist: a named
# configuration file that cannot be read stops the process at startup.
#Environment=PINGWAF_CONFIG=/etc/pingwaf/pingwaf.toml

# The data plane binds 80/443 as the unprivileged pingwaf user. Ambient
# capabilities survive NoNewPrivileges=true, unlike `setcap` on the binary.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pingwaf /etc/pingwaf
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Files the service creates (cache snapshots, ACME state) are private by default.
UMask=0077

[Install]
WantedBy=multi-user.target
